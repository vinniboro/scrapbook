    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "portfolio-website": "file:./vendor/portfolio-website",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
